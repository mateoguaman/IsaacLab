###
# Hyak (Klone) cluster settings (shared, tracked)
# User-specific values come from .env.user
###

CLUSTER_JOB_SCHEDULER=SLURM
CLUSTER_LOGIN=${HYAK_LOGIN}
CLUSTER_ISAACLAB_DIR=${HYAK_DIR}
CLUSTER_ISAAC_SIM_CACHE_DIR=${HYAK_CACHE_DIR}
CLUSTER_SIF_PATH=${HYAK_SIF_PATH}
CLUSTER_MOUNT_DIR=/mmfs1
REMOVE_CODE_COPY_AFTER_JOB=false
CLUSTER_PYTHON_EXECUTABLE=${CLUSTER_PYTHON_EXECUTABLE:-scripts/reinforcement_learning/rsl_rl/train.py}

# SLURM parameter mappings (from .env.user defaults)
ACCOUNT=${ACCOUNT:-${HYAK_SLURM_ACCOUNT}}
PARTITION=${PARTITION:-${HYAK_PARTITION}}
CPUS_PER_TASK=${CPUS_PER_TASK:-${HYAK_CPUS_PER_TASK}}
MEM_PER_GPU=${MEM_PER_GPU:-${HYAK_MEM_PER_GPU}}
CONSTRAINT=${CONSTRAINT:-${HYAK_CONSTRAINT}}
TIME=${TIME:-${HYAK_TIME}}
SLURM_LOGS_DIR=${SLURM_LOGS_DIR:-${HYAK_SLURM_LOGS_DIR}}

###
# Delta (NSF ACCESS) cluster settings (shared, tracked)
# User-specific values come from .env.user
###

CLUSTER_JOB_SCHEDULER=SLURM
CLUSTER_LOGIN=${DELTA_LOGIN}
CLUSTER_ISAACLAB_DIR=${DELTA_DIR}
CLUSTER_ISAAC_SIM_CACHE_DIR=${DELTA_CACHE_DIR}
CLUSTER_SIF_PATH=${DELTA_SIF_PATH}
CLUSTER_MOUNT_DIR=/work
REMOVE_CODE_COPY_AFTER_JOB=false
CLUSTER_PYTHON_EXECUTABLE=${CLUSTER_PYTHON_EXECUTABLE:-scripts/reinforcement_learning/rsl_rl/train.py}

# SLURM parameter mappings (from .env.user defaults)
ACCOUNT=${ACCOUNT:-${DELTA_SLURM_ACCOUNT}}
PARTITION=${PARTITION:-${DELTA_PARTITION}}
CPUS_PER_TASK=${CPUS_PER_TASK:-${DELTA_CPUS_PER_TASK}}
MEM_PER_GPU=${MEM_PER_GPU:-${DELTA_MEM_PER_GPU}}
TIME=${TIME:-${DELTA_TIME}}
SLURM_LOGS_DIR=${SLURM_LOGS_DIR:-${DELTA_SLURM_LOGS_DIR}}

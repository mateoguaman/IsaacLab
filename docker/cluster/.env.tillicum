###
# Tillicum cluster settings (shared, tracked)
# User-specific values come from .env.user
###

CLUSTER_JOB_SCHEDULER=SLURM
CLUSTER_LOGIN=${TILLICUM_LOGIN}
CLUSTER_ISAACLAB_DIR=${TILLICUM_DIR}
CLUSTER_ISAAC_SIM_CACHE_DIR=${TILLICUM_CACHE_DIR}
CLUSTER_SIF_PATH=${TILLICUM_SIF_PATH}
CLUSTER_MOUNT_DIR=/gpfs
REMOVE_CODE_COPY_AFTER_JOB=false
CLUSTER_PYTHON_EXECUTABLE=${CLUSTER_PYTHON_EXECUTABLE:-scripts/reinforcement_learning/rsl_rl/train.py}

# SLURM parameter mappings (from .env.user defaults)
TIME=${TIME:-${TILLICUM_TIME}}
QOS=${QOS:-${TILLICUM_QOS}}
SLURM_LOGS_DIR=${SLURM_LOGS_DIR:-${TILLICUM_SLURM_LOGS_DIR}}

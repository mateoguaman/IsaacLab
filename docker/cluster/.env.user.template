###############################################################################
# IsaacLab UW Cluster User Configuration
#
# Copy this file to .env.user and fill in your values:
#   cp docker/cluster/.env.user.template docker/cluster/.env.user
#
# This is the ONLY file you need to edit for cluster setup.
#
# Sections:
#   [REQUIRED] You must set these before anything works.
#   [OPTIONAL] Sensible defaults — change here, or override per-job with env
#              vars, e.g.  PARTITION=ckpt-all ./cluster_interface.sh job ...
#   [DERIVED]  Auto-computed from the values above. Only change if your
#              cluster paths differ from the UW defaults.
###############################################################################


# ============================================================================
# [REQUIRED] — you must set these
# ============================================================================

# UW NetID (same on both clusters).
CLUSTER_USER="<your-uw-netid>"

# Hyak SLURM --account= — which group's GPU allocation you use (e.g. weirdlab).
HYAK_SLURM_ACCOUNT="<your-lab-group>"

# Hyak /gscratch group — storage under /gscratch/<group>/<netid>/.
# Override for cross-group setups (e.g. account=weirdlab, storage=robotics).
HYAK_STORAGE_GROUP="<your-storage-group>"

# --- Delta (NSF ACCESS) — leave NCSA_USERNAME blank to skip Delta setup ---

# NCSA username — separate from your UW NetID. From ACCESS Portal → My Profile
# → Resource Provider Site Usernames.
NCSA_USERNAME="<your-ncsa-username>"

# Delta SLURM --account=<name>. Run `accounts` on Delta (e.g. bhiq-delta-gpu).
DELTA_SLURM_ACCOUNT="<your-delta-slurm-account>"

# DeltaAI SLURM --account=<name>. Run `accounts` on DeltaAI (e.g. bhiq-dtai-gh).
# Leave blank to skip DeltaAI even when NCSA_USERNAME is set.
DELTAAI_SLURM_ACCOUNT="<your-deltaai-slurm-account>"

# NCSA project code — filesystem name under /work/hdd/<code>. Usually the
# prefix of DELTA_SLURM_ACCOUNT (e.g. bhiq-delta-gpu → bhiq).
NCSA_PROJECT_CODE="<your-ncsa-project-code>"


# ============================================================================
# [OPTIONAL] — Hyak SLURM defaults
# ============================================================================

HYAK_PARTITION=gpu-a40                          # Default: gpu-a40
HYAK_CPUS_PER_TASK=6                            # Default: 6
HYAK_MEM_PER_GPU=60G                            # Default: 60G
HYAK_CONSTRAINT="h200|l40|l40s|a40|a100"        # Default: "h200|l40|l40s|a40|a100"
HYAK_TIME=24:00:00                              # Default: 24:00:00
HYAK_SLURM_LOGS_DIR=/gscratch/${HYAK_STORAGE_GROUP}/${CLUSTER_USER}/slurm_logs


# ============================================================================
# [OPTIONAL] — Tillicum SLURM defaults
# ============================================================================

TILLICUM_TIME=24:00:00                          # Default: 24:00:00
TILLICUM_QOS=normal                             # Default: normal
TILLICUM_SLURM_LOGS_DIR=/gpfs/scrubbed/${CLUSTER_USER}/slurm_logs


# ============================================================================
# [OPTIONAL] — Delta (NSF ACCESS) SLURM defaults
# ============================================================================

DELTA_PARTITION=gpuA100x4                       # Default: gpuA100x4
DELTA_CPUS_PER_TASK=16                          # Default: 16
DELTA_MEM_PER_GPU=64G                           # Default: 64G (per GPU; multiplied by GPUS_PER_NODE)
DELTA_TIME=24:00:00                             # Default: 24:00:00
DELTA_SLURM_LOGS_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/slurm_logs


# ============================================================================
# [OPTIONAL] — DeltaAI (NSF ACCESS, aarch64 GH200) SLURM defaults
# ============================================================================

DELTAAI_PARTITION=ghx4                          # Default: ghx4 (only non-interactive option)
DELTAAI_CPUS_PER_TASK=16                        # Default: 16 (node has 288 cores / 4 GPUs)
DELTAAI_MEM_PER_GPU=180G                        # Default: 180G (node has ~748 GB / 4 GPUs)
DELTAAI_TIME=24:00:00                           # Default: 24:00:00 (partition max 48h)
DELTAAI_SLURM_LOGS_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/slurm_logs


# ============================================================================
# [DERIVED] — cluster paths (auto-computed from the values above)
# ============================================================================

# Tillicum
TILLICUM_LOGIN=${CLUSTER_USER}@tillicum.hyak.uw.edu
TILLICUM_DIR=/gpfs/scrubbed/${CLUSTER_USER}/isaaclab
TILLICUM_CACHE_DIR=/gpfs/scrubbed/${CLUSTER_USER}/docker-isaac-sim
TILLICUM_SIF_PATH=/gpfs/scrubbed/${CLUSTER_USER}

# Hyak
HYAK_LOGIN=${CLUSTER_USER}@klone1.hyak.uw.edu
HYAK_DIR=/gscratch/${HYAK_STORAGE_GROUP}/${CLUSTER_USER}/isaaclab
HYAK_CACHE_DIR=/gscratch/${HYAK_STORAGE_GROUP}/${CLUSTER_USER}/docker-isaac-sim
HYAK_SIF_PATH=/gscratch/${HYAK_STORAGE_GROUP}/${CLUSTER_USER}

# Delta (NSF ACCESS)
DELTA_LOGIN=${NCSA_USERNAME}@login.delta.ncsa.illinois.edu
DELTA_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/isaaclab
DELTA_CACHE_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/docker-isaac-sim
DELTA_SIF_PATH=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}

# DeltaAI (NSF ACCESS, aarch64 GH200). Shares /work with Delta; cache + SIF
# under sif/ for arch separation. CACHE_DIR basename stays "docker-isaac-sim"
# so apptainer binds match after `cp -r $CACHE_DIR $JOB_TMPDIR`.
DELTAAI_LOGIN=${NCSA_USERNAME}@dtai-login.delta.ncsa.illinois.edu
DELTAAI_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/isaaclab
DELTAAI_CACHE_DIR=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/sif/docker-isaac-sim
DELTAAI_SIF_PATH=/work/hdd/${NCSA_PROJECT_CODE}/${NCSA_USERNAME}/sif

###
# DeltaAI (NSF ACCESS, aarch64 GH200) cluster settings (shared, tracked)
# User-specific values come from .env.user
###

CLUSTER_JOB_SCHEDULER=SLURM
CLUSTER_LOGIN=${DELTAAI_LOGIN}
CLUSTER_ISAACLAB_DIR=${DELTAAI_DIR}
CLUSTER_ISAAC_SIM_CACHE_DIR=${DELTAAI_CACHE_DIR}
CLUSTER_SIF_PATH=${DELTAAI_SIF_PATH}
CLUSTER_MOUNT_DIR=/work
REMOVE_CODE_COPY_AFTER_JOB=false
CLUSTER_PYTHON_EXECUTABLE=${CLUSTER_PYTHON_EXECUTABLE:-scripts/reinforcement_learning/rsl_rl/train.py}

# SLURM parameter mappings (from .env.user defaults)
ACCOUNT=${ACCOUNT:-${DELTAAI_SLURM_ACCOUNT}}
PARTITION=${PARTITION:-${DELTAAI_PARTITION}}
CPUS_PER_TASK=${CPUS_PER_TASK:-${DELTAAI_CPUS_PER_TASK}}
MEM_PER_GPU=${MEM_PER_GPU:-${DELTAAI_MEM_PER_GPU}}
TIME=${TIME:-${DELTAAI_TIME}}
SLURM_LOGS_DIR=${SLURM_LOGS_DIR:-${DELTAAI_SLURM_LOGS_DIR}}

CLUSTER_RUNTIME_PIP_DEPS="shapely mapbox-earcut manifold3d ${DELTAAI_SIF_PATH}/wheels/pytorch3d-0.7.9-cp312-cp312-linux_aarch64.whl"
